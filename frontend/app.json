{
  "expo": {
    "name": "PsychoLyrics",
    "slug": "psycholyrics",
    "version": "1.0.0",
    "scheme": "psycholyrics",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.roisoyboy.psycholyrics",
      "supportsTablet": true
    },
    "plugins": [
      "./plugins/withAndroidWidget",
      "./plugins/withIOSWidget",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.roisoyboy.psycholyrics"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
