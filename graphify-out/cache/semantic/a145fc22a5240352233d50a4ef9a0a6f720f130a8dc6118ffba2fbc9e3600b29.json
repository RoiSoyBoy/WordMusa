{"nodes": [{"id": "docs_retros_2026_05_12_lyrics_scroll_ux", "label": "Retro: Lyrics Screen UX & Scroll Overhaul", "file_type": "document", "source_file": "docs/retros/2026-05-12-lyrics-scroll-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_retros_2026_05_12_bug_touchableopacity_scroll_conflict", "label": "Bug: TouchableOpacity Blocked Scroll+Tap", "file_type": "rationale", "source_file": "docs/retros/2026-05-12-lyrics-scroll-ux.md", "source_location": "What broke and why", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nested Text.onLongPress inside TouchableOpacity inside ScrollView caused touch responder conflict on Android; fixed by switching to Pressable + keyboardShouldPersistTaps=handled."}, {"id": "docs_retros_2026_05_12_bug_translation_40s_delay", "label": "Bug: Translation Took 40s (onLayout storm)", "file_type": "rationale", "source_file": "docs/retros/2026-05-12-lyrics-scroll-ux.md", "source_location": "What broke and why", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onLayout fired on every Pressable on each streaming setLines update (50 lines x 60 chunks = 3000 callbacks); fixed via lazy measureLayout called only when auto-scroll fires."}, {"id": "docs_retros_2026_05_12_decision_measurelayout", "label": "measureLayout Over onLayout Decision", "file_type": "rationale", "source_file": "docs/retros/2026-05-12-lyrics-scroll-ux.md", "source_location": "Decisions made", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lazy measurement is more accurate (reflects current heights including translations) and eliminates streaming overhead; proximity threshold 250px chosen as natural but not annoying."}], "edges": [{"source": "docs_retros_2026_05_12_lyrics_scroll_ux", "target": "frontend_src_screens_nowplayingscreen", "relation": "references", "confidence"