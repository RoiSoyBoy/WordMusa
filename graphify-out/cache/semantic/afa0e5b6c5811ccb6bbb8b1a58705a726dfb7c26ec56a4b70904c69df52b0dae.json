{"nodes": [{"id": "taskmaster_docs_prd", "label": "LyricLearn PRD v1.1", "file_type": "document", "source_file": ".taskmaster/docs/prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_spotify_integration", "label": "Spotify Integration (PRD 4.2.1)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_synced_lyrics_display", "label": "Synchronized Lyrics Display (PRD 4.2.2)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_hebrew_translation_system", "label": "Hebrew Translation System (PRD 4.2.3)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_psychometric_vocabulary_system", "label": "Psychometric Vocabulary System (PRD 4.2.4)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_word_detail_view", "label": "Word Detail View (PRD 4.2.5)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_progress_gamification", "label": "Progress & Gamification (PRD 4.2.6)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_onboarding_flow", "label": "Onboarding Flow (PRD 4.2.7)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 4.2.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_word_learned_definition", "label": "Definition of Word Learned", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A word is considered learned when encountered in lyrics on 3+ separate sessions AND user has tapped the word card at least once to view full definition \u2014 conservative proxy for retention."}, {"id": "taskmaster_docs_prd_firestore_data_model", "label": "Firestore Data Model (PRD 5.2)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_data_flow_happy_path", "label": "Data Flow \u2014 Happy Path (PRD 5.3)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_gpt_translation_prompt", "label": "GPT Translation Prompt (PRD 5.4)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_api_risk_assessment", "label": "API Dependencies & Risk Assessment (PRD 5.5)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Musixmatch flagged HIGH risk (mitigate via Firestore cache + fallback to unsynced lyrics + evaluate Genius API backup); gpt-4o-mini flagged LOW risk because global cache means API rarely called."}, {"id": "taskmaster_docs_prd_performance_targets", "label": "Performance Targets (PRD 5.6)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_edge_case_loading_delay", "label": "Case 1: Loading Delay on New Song", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progressive Display + Streaming strategy: show track title immediately, display English lyrics unstyled first, stream translations in via gpt-4o-mini, cache once complete \u2014 never show a blank screen."}, {"id": "taskmaster_docs_prd_edge_case_skip_song", "label": "Case 2: User Skips Song Within 5 Seconds", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AbortController strategy: abort in-flight translation request on track change to avoid wasted tokens and stale cache writes."}, {"id": "taskmaster_docs_prd_edge_case_app_opened_mid_song", "label": "Case 3: App Opened Mid-Song", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Position-Aware Load: use first poll's position_ms to jump directly to the correct lyric line instead of starting from line 0."}, {"id": "taskmaster_docs_prd_edge_case_network_dropout", "label": "Case 4: Network Dropout", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconnect & Re-sync: freeze highlight silently while offline, then jump to correct current line on reconnect rather than animating through missed lines."}, {"id": "taskmaster_docs_prd_edge_case_song_not_found", "label": "Case 5: Song Not Found in Musixmatch", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graceful Degradation: show Hebrew message that lyrics are unavailable and a report-missing-song button logging to missing_tracks collection; treated as a known handled state, not an error."}, {"id": "taskmaster_docs_prd_edge_case_shuffle_mode", "label": "Case 6: Shuffle Mode \u2014 No Pre-fetch Possible", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimistic Immediate Display: disable pre-fetch in shuffle mode, rely on cache-hit-first logic identical to Case 1."}, {"id": "taskmaster_docs_prd_edge_case_cache_misses_new_album", "label": "Case 7: Many Consecutive Cache Misses (New Album)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend Queue + Soft Rate Limit: max 1 concurrent Claude translation request per user, queue additional requests, return English-only lyrics immediately, cache-warming cost shared across user base."}, {"id": "taskmaster_docs_prd_edge_case_pause_resume", "label": "Case 8: Rapid Pause/Resume", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Position Delta Detection: compare position_ms between consecutive polls instead of relying on is_playing flag, which is unreliable for short pauses."}, {"id": "taskmaster_docs_prd_edge_case_song_loop", "label": "Case 9: Song on Repeat (Loop)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 5.7 Case 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loop Detection: if position_ms drops below 3000ms while previous position was near duration_ms and track ID unchanged, treat as loop \u2014 reset to line 0 without re-fetching lyrics/translations."}, {"id": "taskmaster_docs_prd_ux_design_principles", "label": "UX & Design Principles (PRD 6.1)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 6.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero behavior change, passive learning first, tap for depth never forced, dark-first design, Hebrew-native UI, delight without distraction \u2014 the app serves the music, not the other way around."}, {"id": "taskmaster_docs_prd_screen_structure", "label": "Screen Structure (PRD 6.2)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 6.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_monetization_strategy", "label": "Monetization Strategy (PRD 7)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_cost_profitability_analysis", "label": "Cost & Profitability Analysis (PRD 7.3)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 7.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global translation cache is the most important cost lever \u2014 marginal AI cost per active user approaches ~$0 as catalog grows; break-even at ~500 premium subscribers, profitability at ~2,000."}, {"id": "taskmaster_docs_prd_development_roadmap", "label": "Development Roadmap (PRD 8)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_risks_mitigations", "label": "Risks & Mitigations (PRD 9)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Musixmatch cost/availability at scale and Spotify free-tier Playback State API access flagged HIGH severity; mitigations include caching, fallback providers, and manual input fallback."}, {"id": "taskmaster_docs_prd_open_questions", "label": "Open Questions (PRD 10)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_security_requirements", "label": "Security Requirements (PRD 11)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_api_key_management", "label": "API Key Management (PRD 11.1)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All third-party API keys must be stored exclusively on the backend and never appear in the app bundle, client code, git repos, or store builds \u2014 Cloud Functions act as proxy layer."}, {"id": "taskmaster_docs_prd_auth_session_security", "label": "Authentication & Session Security (PRD 11.2)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_firestore_security_rules", "label": "Firestore Security Rules (PRD 11.3)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_transport_security", "label": "Transport Security (PRD 11.4)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_data_minimization_privacy", "label": "Data Minimization & Privacy (PRD 11.5)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only collect data strictly necessary; Spotify OAuth scope limited to playback state read only; raw lyrics never permanently stored, only translated line pairs, to reduce copyright liability."}, {"id": "taskmaster_docs_prd_input_validation", "label": "Input Validation & Injection Prevention (PRD 11.6)", "file_type": "rationale", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-provided lyric lines passed as content, never injected into the system prompt, to prevent prompt injection attacks."}, {"id": "taskmaster_docs_prd_dependency_security", "label": "Dependency Security (PRD 11.7)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_backend_security", "label": "Backend Security (PRD 11.8)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_incident_response", "label": "Incident Response (PRD 11.9)", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 11.9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "taskmaster_docs_prd_persona_roi", "label": "Primary User Persona: Roi, 20", "file_type": "concept", "source_file": ".taskmaster/docs/prd.md", "source_location": "section 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [], "hyperedges": []}